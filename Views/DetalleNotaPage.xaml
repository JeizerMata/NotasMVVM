<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NotasMVVM.ViewModels"
             x:Class="NotasMVVM.Views.DetalleNotaPage"
             x:DataType="vm:DetalleNotaViewModel"
             Title="Detalle de Nota">

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="10">
            <Label Text="Título (obligatorio, máx. 100 caracteres)" FontAttributes="Bold" />
            <Entry Text="{Binding Titulo}" Placeholder="Título de la nota" MaxLength="100" />

            <Label Text="Contenido" FontAttributes="Bold" />
            <Editor Text="{Binding Contenido}" Placeholder="Escribe tu nota aquí..."
                    HeightRequest="200" />

            <Button Text="Guardar" Command="{Binding GuardarCommand}"
                    BackgroundColor="#512BD4" TextColor="White" FontSize="16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
